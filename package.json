{
  "name": "agent-charts",
  "version": "2.2.0",
  "description": "Inline terminal charts for coding agents (OpenCode v2 TUI and Claude Code): ```chart blocks render as line, area, bar, column, heatmap, calendar, candlestick, pie, gauge, box plot, waterfall and sparkline charts, with zero runtime dependencies",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hashd1ve/agent-charts.git"
  },
  "keywords": [
    "agents",
    "braille",
    "candlestick",
    "charts",
    "claude-code",
    "claude-code-plugin",
    "heatmap",
    "opencode",
    "opencode-plugin",
    "sparklines",
    "terminal",
    "tui"
  ],
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.ts"
  },
  "files": [
    "index.ts",
    "tui.ts",
    "render.ts",
    "chart.ts",
    "prompt.ts",
    "engine"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "demo": "bun scripts/demo.ts",
    "install-plugin": "bun scripts/install.ts",
    "sync:claude": "bun scripts/sync-claude-mod.ts",
    "test:claude": "bun scripts/sync-claude-mod.ts --check && claude plugin test claude-code",
    "screenshots": "bun scripts/screenshots.ts"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.23",
    "@opentui/core": ">=0.5.14"
  },
  "devDependencies": {
    "@opentui/core": "0.5.14",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
